# Copy to .env with `make init-env`. .env is gitignored: never commit real secrets.
# Docker Compose AND the Makefile both read this file, so avoid '#', '$' and quotes in values.
# Keep POSTGRES_PASSWORD and RABBITMQ_DEFAULT_PASS to letters/digits only: both are embedded in URLs.

# --- Postgres (one server, one database per service; see infra/postgres/init.sql) ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=change_me_pg_password
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=wallet
RABBITMQ_DEFAULT_PASS=change_me_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Grafana (http://localhost:3000, user: admin) ---
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# --- Shared by every service ---
LOG_LEVEL=INFO
# Generate with: make secret   (must be at least 32 characters)
JWT_SECRET=change-me-run-make-secret-and-paste-the-output-here
JWT_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# --- Optional tuning (these are the defaults; uncomment to change) ---
# RATE_LIMIT_TRANSFERS_PER_MINUTE=20
# RATE_LIMIT_READS_PER_MINUTE=120
# BALANCE_CACHE_TTL_SECONDS=60
# FRAUD_MAX_TRANSFERS_PER_WINDOW=5
# FRAUD_WINDOW_SECONDS=60

# --- Host ports ---
AUTH_SERVICE_PORT=8001
WALLET_SERVICE_PORT=8002
NOTIFICATION_SERVICE_PORT=8003
GATEWAY_PORT=8080
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Production on EC2 only (see docs/DEPLOYMENT.md); leave commented in development ---
# DOMAIN=api.example.com
# ACME_EMAIL=you@example.com
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml
